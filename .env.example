# --- Firebase Admin SDK (Read-Only against freshbyely Firestore) ---
# Provide EITHER a local path to your service account JSON OR base64-encoded JSON (used in GitHub Actions)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_B64=

# --- Gemini API (AI Restock & Ops Briefing) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Gmail SMTP Delivery ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
REPORT_RECIPIENT_EMAIL=

# --- Store Metadata & Runtime ---
STORE_NAME=Ely's Fresh Fruits & Veggies (ely.pos)
TIMEZONE=Asia/Manila
OUTPUT_DIR=output

# --- Free-Tier & Abuse Safety Caps ---
MAX_FIRESTORE_READS=500
MAX_AI_CALLS_PER_DAY=10
MAX_AI_OUTPUT_TOKENS=1200
ALLOW_NON_FREE_MODEL=false
